# ── Copia este archivo como .env y edita los valores ──────────────────────────
# Ubicacion: sistema-optica/deploy/.env

# Base de datos
DB_USER=optica
DB_PASSWORD=CambiaEstaContrasena2024!
DB_NAME=optica

# Redis
REDIS_PASSWORD=RedisPass2024!

# JWT: clave secreta que firma las sesiones. OBLIGATORIO cambiarla (el sistema no
# arranca con la de ejemplo). Genera una con el comando de la guia de instalacion.
JWT_SECRET=CAMBIA_ESTO_POR_UNA_CADENA_MUY_LARGA_Y_ALEATORIA_DE_AL_MENOS_64_CARACTERES

# WhatsApp Business API (opcional — dejar en blanco si no se usa)
WA_TOKEN=
WA_PHONE_ID=
WA_BIRTHDAY_TEMPLATE=
WA_BIRTHDAY_LANG=es

# Email para reportes mensuales (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Zona horaria del negocio (fecha de "hoy" en ventas, cobros y caja)
TZ=America/Guayaquil

# Respaldos automaticos (carpeta deploy/respaldos): cuantos dias se guardan
RESPALDO_DIAS=30
